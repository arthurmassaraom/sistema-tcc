# Copie para .env e preencha com seus valores. Nunca versione o .env real.

# MySQL local (deixe MYSQL_DATABASE vazio para usar SQLite em instance/biblioteca.db).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=biblioteca_app
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=biblioteca_db

# development | production. Em produção, SECRET_KEY é obrigatória (32+ caracteres).
APP_ENV=development
SECRET_KEY=gere-um-valor-aleatorio-com-pelo-menos-32-caracteres
# Só use false em desenvolvimento servido por HTTP. Produção sempre ativa Secure.
SESSION_COOKIE_SECURE=false

# Login Google (OIDC): mantenha o Client Secret apenas no servidor.
GOOGLE_CLIENT_ID=000000000000-exemplo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=exemplo-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/login/google/callback

# demo = Pix e cartão simulados (recomendado para este projeto).
PAYMENT_MODE=demo

# Mantidas apenas por compatibilidade; não usadas em modo demo.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=

# Dados institucionais exibidos no rodapé e na Política de Privacidade.
# Deixe vazio para exibir "Não informado". Use apenas dados oficiais.
BUSINESS_CNPJ=00.000.000/0000-00
BUSINESS_ADDRESS=Rua Exemplo, 123 - Cidade, UF
BUSINESS_PHONE=(11) 0000-0000
BUSINESS_WHATSAPP=5511000000000
BUSINESS_EMAIL=contato@exemplo.org

# Opcional: DATABASE_URL tem prioridade sobre MYSQL_*.
# DATABASE_URL=sqlite:///instance/biblioteca.db

# ---- Opcionais adicionados na revisão de interface (todos têm padrão seguro) ----
# true: cria tabelas, aplica migrações aditivas e o seed ao iniciar.
AUTO_INIT_DATABASE=true
# Chave da Google Geocoding API (somente servidor). Vazia = mapas desativados com aviso.
GOOGLE_MAPS_API_KEY=
# Taxa única de entrega em domicílio (R$).
DELIVERY_FEE=12.90
# Área de entrega: UFs e/ou cidades separadas por vírgula. Vazio = sem restrição.
DELIVERY_STATES=SP
DELIVERY_CITIES=
# Alertas de distância (km): pino longe do centro do CEP e biblioteca longe na retirada.
GEO_ALERT_KM=2
PICKUP_ALERT_KM=15
# Consulta ao ViaCEP para validar o CEP no checkout.
CEP_LOOKUP_ENABLED=true
TERMS_VERSION=2026-11
PRIVACY_VERSION=2026-11
